AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://nedolinko-0140-resource.services.ai.azure.com/openai/v1
AZURE_TEXT_DEPLOYMENT=DeepSeek-V4-Flash
AZURE_VISION_DEPLOYMENT=grok-4.6
AZURE_REASONING_EFFORT=low
AZURE_IMAGE_ENDPOINT=https://nedolinko-0140-resource.services.ai.azure.com/providers/blackforestlabs/v1/flux-2-pro?api-version=preview
AZURE_SPEECH_ENDPOINT=https://nedolinko-0140-resource.cognitiveservices.azure.com
# Optional if Speech uses a different resource key:
AZURE_SPEECH_KEY=
# Standard Canadian French voices keep synthesis costs down. HD names also work.
AZURE_VOICE_FEMALE=fr-CA-SylvieNeural
AZURE_VOICE_MALE=fr-CA-ThierryNeural
# Required: choose a backend access token and enter it in the app's connection settings.
TCF_API_TOKEN=
TCF_DATA_DIR=./data
TCF_DAILY_SESSION_LIMIT=8
